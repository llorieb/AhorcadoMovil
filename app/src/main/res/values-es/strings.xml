    <string name="help_goal_title">Objetivo</string>
    <string name="help_goal_body">Descubrí la palabra oculta antes de quedarte sin intentos o sin tiempo.</string>
    <string name="help_letters_title">Elegir letras</string>
    <string name="help_letters_body">Seleccioná una letra del teclado. Si está en la palabra, se revelan todas sus apariciones y la tecla queda marcada en verde. Si no está, la tecla queda marcada en rojo y el personaje avanza un paso.</string>
    <string name="help_guess_title">Arriesgar respuesta</string>
    <string name="help_guess_body">Podés intentar resolver la palabra completa en cualquier momento con Arriesgar. Si acertás, ganás la partida. Si la respuesta es incorrecta, la partida termina.</string>
    <string name="help_time_title">Tiempo</string>
    <string name="help_time_body">Cada partida tiene un límite de tiempo. El valor predeterminado es 30 segundos y podés elegir 15, 30, 45 o 60 segundos desde Preferencias.</string>
    <string name="help_categories_title">Categorías</string>
    <string name="help_categories_body">Desde Preferencias podés jugar con Países, Ciudades, Marcas de autos o Bandas de Rock. Países es la categoría predeterminada.</string>
    <string name="help_accents_title">Tildes y nombres compuestos</string>
    <string name="help_accents_body">No necesitás escribir tildes para acertar. Por ejemplo, A también descubre Á. Los espacios, guiones, apóstrofes y otros signos se muestran automáticamente. Al arriesgar una respuesta completa también podés omitir esos signos.</string>
    <string name="help_controls_title">Controles</string>
    <string name="help_controls_body">Jugar inicia una nueva partida. Detener termina la partida actual. Arriesgar permite escribir la respuesta completa. La rueda abre Preferencias y Salir está disponible en el menú de opciones.</string>

    <string name="privacy_policy">Política de privacidad</string>
    <string name="privacy_label">POLÍTICA DE PRIVACIDAD</string>
    <string name="privacy_title">Política de privacidad</string>
    <string name="privacy_last_updated">Última actualización: 18 de septiembre de 2026</string>

    <string name="privacy_summary_title">Resumen</string>
    <string name="privacy_summary_body">Ahorcado es un juego de palabras sin conexión desarrollado por Mario Borelli. La aplicación no recopila, almacena, transmite ni comparte datos personales.</string>

    <string name="privacy_data_title">Recopilación de datos</string>
    <string name="privacy_data_body">Ahorcado no requiere una cuenta y no recopila nombres, direcciones de correo electrónico, identificadores del dispositivo, ubicación, contactos, fotos, archivos, estadísticas de uso ni ningún otro dato personal.</string>

    <string name="privacy_permissions_title">Permisos y acceso a la red</string>
    <string name="privacy_permissions_body">La aplicación no solicita permisos de Android ni acceso a Internet. El contenido del juego está incluido en la aplicación y funciona sin conexión.</string>

    <string name="privacy_local_title">Preferencias locales</string>
    <string name="privacy_local_body">Preferencias como la categoría, el tiempo de juego y el idioma pueden almacenarse localmente en el dispositivo. Esos datos no se transmiten a ningún lugar y se eliminan al borrar los datos de la aplicación o desinstalarla.</string>

    <string name="privacy_third_party_title">Publicidad, analítica y terceros</string>
    <string name="privacy_third_party_body">Ahorcado no contiene publicidad, analítica, rastreadores ni servicios de terceros que reciban datos del usuario.</string>

    <string name="privacy_children_title">Menores</string>
    <string name="privacy_children_body">Ahorcado no recopila datos personales de ningún usuario, incluidos los menores.</string>

    <string name="privacy_contact_title">Desarrollador y contacto</string>
    <string name="privacy_contact_body">Desarrollador: Mario Borelli\nContacto: mborelli@gmail.com</string>

