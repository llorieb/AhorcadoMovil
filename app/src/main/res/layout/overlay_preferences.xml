<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="18dp"
    app:cardElevation="12dp"
    app:strokeColor="#A9CDEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_inner"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:letterSpacing="0.08"
            android:text="@string/preferences_overlay_label"
            android:textColor="#6B8EAE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/preferences_title"
            android:textColor="#1F2937"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/preferences_description"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_overlay_section"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/category_label"
                        android:textColor="#245B8F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/categoryGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <RadioButton android:id="@+id/categoryCountries" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/category_countries" />
                        <RadioButton android:id="@+id/categoryCities" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/category_cities" />
                        <RadioButton android:id="@+id/categoryCarBrands" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/category_car_brands" />
                        <RadioButton android:id="@+id/categoryRockBands" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/category_rock_bands" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_overlay_section"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/time_per_game"
                        android:textColor="#245B8F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/timeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <RadioButton android:id="@+id/time15" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/seconds_15" />
                        <RadioButton android:id="@+id/time30" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/seconds_30" />
                        <RadioButton android:id="@+id/time45" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/seconds_45" />
                        <RadioButton android:id="@+id/time60" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="0dp" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp" android:buttonTint="@color/primary_dark" android:textSize="13sp" android:text="@string/seconds_60" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_overlay_section"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_label"
                        android:textColor="#245B8F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/languageGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/languageAutomatic"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:buttonTint="@color/primary_dark"
                            android:gravity="center_vertical"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/language_automatic"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/languageSpanish"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:buttonTint="@color/primary_dark"
                            android:gravity="center_vertical"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/language_spanish"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/languageEnglish"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:buttonTint="@color/primary_dark"
                            android:gravity="center_vertical"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/language_english"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelPreferencesButton"
                style="@style/Widget.Ahorcado.Button.OverlaySecondary"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/cancel"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/savePreferencesButton"
                style="@style/Widget.Ahorcado.Button.OverlayPrimary"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/save"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
