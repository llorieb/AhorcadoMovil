    <string name="help_goal_title">Objective</string>
    <string name="help_goal_body">Guess the hidden word before you run out of attempts or time.</string>
    <string name="help_letters_title">Choose letters</string>
    <string name="help_letters_body">Select a letter on the keyboard. If it appears in the answer, all of its occurrences are revealed and the key turns green. If it does not, the key turns red and the character advances one step.</string>
    <string name="help_guess_title">Guess the answer</string>
    <string name="help_guess_body">You can try to solve the full word or phrase at any time with Guess. If you are correct, you win the game. If the answer is incorrect, the game ends.</string>
    <string name="help_time_title">Time</string>
    <string name="help_time_body">Each game has a time limit. The default is 30 seconds, and you can choose 15, 30, 45 or 60 seconds in Settings.</string>
    <string name="help_categories_title">Categories</string>
    <string name="help_categories_body">In Settings you can play with Countries, Cities, Car brands or Rock bands. Countries is the default category.</string>
    <string name="help_accents_title">Accents and compound names</string>
    <string name="help_accents_body">You do not need to type accents to guess correctly. For example, A also reveals Á. Spaces, hyphens, apostrophes and other punctuation are shown automatically. When guessing the full answer, you can omit those signs too.</string>
    <string name="help_controls_title">Controls</string>
    <string name="help_controls_body">Play starts a new game. Stop ends the current game. Guess lets you enter the full answer. The gear opens Settings, and Exit is available from the options menu.</string>

    <string name="privacy_policy">Privacy policy</string>
    <string name="privacy_label">PRIVACY POLICY</string>
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_last_updated">Last updated: September 18, 2026</string>

    <string name="privacy_summary_title">Summary</string>
    <string name="privacy_summary_body">Ahorcado is an offline word game developed by Mario Borelli. The app does not collect, store, transmit or share personal data.</string>

    <string name="privacy_data_title">Data collection</string>
    <string name="privacy_data_body">Ahorcado does not require an account and does not collect names, email addresses, device identifiers, location, contacts, photos, files, usage analytics or any other personal information.</string>

    <string name="privacy_permissions_title">Permissions and network access</string>
    <string name="privacy_permissions_body">The app requests no Android permissions and does not request Internet access. Game content is included with the application and works offline.</string>

    <string name="privacy_local_title">Local preferences</string>
    <string name="privacy_local_body">Settings such as category, game time and language preference may be stored locally on the device. These settings are not transmitted anywhere and are removed when the app data is cleared or the app is uninstalled.</string>

    <string name="privacy_third_party_title">Ads, analytics and third parties</string>
    <string name="privacy_third_party_body">Ahorcado contains no advertising, analytics, trackers or third-party services that receive user data.</string>

    <string name="privacy_children_title">Children</string>
    <string name="privacy_children_body">Ahorcado does not collect personal data from any user, including children.</string>

    <string name="privacy_contact_title">Developer and contact</string>
    <string name="privacy_contact_body">Developer: Mario Borelli\nContact: mborelli@gmail.com</string>

